#include <iostream>
using namespace std;

class Item {
public:
    string name, writer, code;
};

class Store {
    Item list[100];
    int total;

public:
    Store() { total = 0; }

    bool insert(string n, string w, string c) {
        if (total >= 100) return false;
        list[total++] = {n, w, c};
        return true;
    }

    bool remove(string c) {
        for(int i=0;i<total;i++) {
            if(list[i].code == c) {
                for(int j=i;j<total-1;j++)
                    list[j] = list[j+1];
                total--;
                return true;
            }
        }
        return false;
    }

    void show() {
        for(int i=0;i<total;i++) {
            cout<<list[i].name<<endl;
            cout<<list[i].writer<<endl;
            cout<<list[i].code<<endl;
        }
    }
};

int main() {
    Store s;

    s.insert("CPP","A","101");
    s.insert("DS","B","102");
    s.insert("OOP","C","103");

    s.show();

    s.remove("103");

    cout<<"After delete\n";
    s.show();
}
