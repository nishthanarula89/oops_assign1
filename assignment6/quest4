#include <iostream>
using namespace std;

class One;

class Two {
    int b;
public:
    Two(int x){ b=x; }
    friend int sum(One,Two);
};

class One {
    int a;
public:
    One(int x){ a=x; }
    friend int sum(One,Two);
};

int sum(One x, Two y) {
    return x.a + y.b;
}

int main() {
    One a(5);
    Two b(10);

    cout<<sum(a,b)<<endl;
}
