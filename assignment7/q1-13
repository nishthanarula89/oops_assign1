class Clock{
    int h,m,s;
public:
    Clock(int a=0,int b=0,int c=0){ h=a;m=b;s=c; }
    Clock operator+(Clock t){ return Clock(h+t.h,m+t.m,s+t.s); }
    void print(){ cout<<h<<":"<<m<<":"<<s<<endl; }
};

 ================= Q6 ================= 
class Text{
    char data[100];
public:
    Text(){ data[0]='\0'; }
    Text(const char* s){ strcpy(data,s); }
    bool operator==(Text t){ return strcmp(data,t.data)==0; }
    Text operator+(Text t){
        Text temp;
        strcpy(temp.data,data);
        strcat(temp.data,t.data);
        return temp;
    }
    void print(){ cout<<data<<endl; }
};

================= Q7 ================= 
class MatrixA{
    int a[2][2];
public:
    void read(){ for(int i=0;i<2;i++)for(int j=0;j<2;j++)cin>>a[i][j]; }
    void show(){ for(int i=0;i<2;i++){for(int j=0;j<2;j++)cout<<a[i][j]<<" "; cout<<endl;} }
    friend MatrixA operator*(MatrixA,MatrixA);
};

MatrixA operator*(MatrixA x,MatrixA y){
    MatrixA t;
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++){
            t.a[i][j]=0;
            for(int k=0;k<2;k++)
                t.a[i][j]+=x.a[i][k]*y.a[k][j];
        }
    return t;
}

