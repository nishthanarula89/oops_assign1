================= Q1 ================= 
class BaseShape {
public:
    int x,y;
    void setDim(int a,int b){ x=a; y=b; }
    virtual void findArea()=0;
};

class RectA: public BaseShape{
public:
    void findArea(){ cout<<x*y<<" "; }
};

class TriA: public BaseShape{
public:
    void findArea(){ cout<<(x*y)/2<<" "; }
};

================= Q2 ================= 
class AbstractShape{
public:
    virtual void info()=0;
    virtual void calc()=0;
};

class CircleA: public AbstractShape{
    float r;
public:
    CircleA(float v){ r=v; }
    void info(){ cout<<"Circle\n"; }
    void calc(){ cout<<3.14*r*r<<endl; }
};

class RectB: public AbstractShape{
    float l,b;
public:
    RectB(float a,float c){ l=a;b=c; }
    void info(){ cout<<"Rectangle\n"; }
    void calc(){ cout<<l*b<<endl; }
};

class TriB: public AbstractShape{
    float b,h;
public:
    TriB(float a,float c){ b=a;h=c; }
    void info(){ cout<<"Triangle\n"; }
    void calc(){ cout<<0.5*b*h<<endl; }
};

================= Q3 ================= /
class TriangleCalc{
public:
    double area(double a,double b){ return 0.5*a*b; }
    double area(double a){ return (sqrt(3)/4)*a*a; }
    double area(double a,double b,bool){ return 0.5*b*sqrt(a*a-(b*b)/4); }
};

