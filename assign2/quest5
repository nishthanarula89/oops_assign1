#include <iostream>
using namespace std;

class Num {
    float r, i;

public:
    void set(float a, float b) {
        r = a;
        i = b;
    }

    void show() {
        cout << r << " + " << i << "i" << endl;
    }

    Num add(Num x) {
        Num t;
        t.r = r + x.r;
        t.i = i + x.i;
        return t;
    }
};

int main() {
    Num n1, n2, res;
    float a, b;

    cin >> a >> b;
    n1.set(a, b);

    cin >> a >> b;
    n2.set(a, b);

    n1.show();
    n2.show();

    res = n1.add(n2);
    res.show();
}
