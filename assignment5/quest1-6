// q4 (Book/Textbook)
class BookX {
protected:
    string t, a;
    float p;
public:
    BookX(string x, string y, float z) { t = x; a = y; p = z; }
    void show() { cout << t << endl << a << endl << p << endl; }
};

class Txt : public BookX {
    string s;
public:
    Txt(string x, string y, float z, string q) : BookX(x,y,z) { s = q; }
    void print() { show(); cout << s << endl; }
};

// q5
class Veh {
protected:
    string mk, md;
    int yr;
public:
    Veh(string x, string y, int z) { mk = x; md = y; yr = z; }
    void showV() { cout << mk << endl << md << endl << yr << endl; }
};

class Tr : public Veh {
protected:
    int cap;
public:
    Tr(string x, string y, int z, int c) : Veh(x,y,z) { cap = c; }
    void showT() { showV(); cout << cap << endl; }
};

class Ref : public Tr {
    int temp;
public:
    Ref(string x, string y, int z, int c, int t) : Tr(x,y,z,c) { temp = t; }
    void showR() { showT(); cout << temp << endl; }
};

// q6
class PersonX {
protected:
    string n, ad;
public:
    PersonX(string x, string y) { n = x; ad = y; }
    void p() { cout << n << endl << ad << endl; }
};

class StaffX : virtual public PersonX {
protected:
    int id;
    string d;
public:
    StaffX(string x, string y, int i, string dep) : PersonX(x,y) { id = i; d = dep; }
    void s() { p(); cout << id << endl << d << endl; }
};

class StudX : virtual public PersonX {
protected:
    int sid;
    string g;
public:
    StudX(string x, string y, int i, string gr) : PersonX(x,y) { sid = i; g = gr; }
    void st() { p(); cout << sid << endl << g << endl; }
};

class TA : public StaffX, public StudX {
public:
    TA(string x, string y, int i, string dep, int j, string gr)
        : PersonX(x,y), StaffX(x,y,i,dep), StudX(x,y,j,gr) {}
    void all() { s(); st(); }
};

